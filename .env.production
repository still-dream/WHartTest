# =============================================================
# WHartTest 生产环境配置（上传到服务器 /opt/wharttest/.env）
# =============================================================
# 用法：
#   1. 编辑本文件，修改所有"必须修改"的配置
#   2. 上传到服务器：scp .env.production ysup@10.33.156.115:/opt/wharttest/.env
#   3. 在服务器上：chmod 600 .env
# =============================================================

# Django 核心配置（必须修改）
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=wgh19960531
DJANGO_ALLOWED_HOSTS=10.33.156.115,localhost,127.0.0.1,demo-aitest-inner.yunlu-tech.cn
DJANGO_CORS_ALLOWED_ORIGINS=https://demo-aitest-inner.yunlu-tech.cn,http://10.33.156.115:8913,http://localhost:8913

# Django 管理员账号（必须修改）
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_EMAIL=admin@example.com
DJANGO_ADMIN_PASSWORD=wgh19960531

# 数据库配置（生产用 PostgreSQL）
DATABASE_TYPE=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=wharttest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=wgh19960531

# 外部可访问的 URL（通知消息里用）
DJANGO_PUBLIC_BASE_URL=http://10.33.156.115:8913

# MCP / API Key（必须修改）
WHARTTEST_API_KEY=wgh19960531
WHARTTEST_BACKEND_URL=http://backend:8000

# 国内镜像源（构建加速）
DOCKER_APT_BASE_URL=https://mirrors.tuna.tsinghua.edu.cn
DOCKER_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
DOCKER_PIP_INDEX_FALLBACKS=https://pypi.org/simple
DOCKER_NPM_REGISTRY=https://registry.npmmirror.com
DOCKER_HF_ENDPOINT=https://hf-mirror.com
DOCKER_CHROME_FOR_TESTING_MIRROR=https://cdn.npmmirror.com/binaries/chrome-for-testing
DOCKER_CHROME_VERSION=stable
# ★ Playwright 浏览器国内镜像
DOCKER_PLAYWRIGHT_DOWNLOAD_HOST=https://npmmirror.com/mirrors/playwright

# Playwright MCP 镜像（用微软原地址，1ms.run 不镜像 mcr.microsoft.com）
# 如果 mcr.microsoft.com 拉不动，可换成：dockerproxy.cn/microsoft/playwright/mcp
DOCKER_PLAYWRIGHT_MCP_IMAGE=mcr.microsoft.com/playwright/mcp

# AI API（如果有）
AI_API_URL=https://api.example.com/v1
AI_API_KEY=sk-xxxxx
AI_MODEL=your-model-name

# 飞书（可选）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
